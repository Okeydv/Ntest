# Конфигурация e2ee-key-server. README предписывает `cp .env.example .env`,
# но самого файла в репозитории не было — сервис не запускался по инструкции.
#
# У этого сервиса своё окружение, отдельное от Node-приложения, и имена
# переменных намеренно другие: INTERNAL_SHARED_SECRET здесь должен совпадать
# по ЗНАЧЕНИЮ с INTERNAL_KEY_SERVER_SECRET в корневом .env, но не по имени.

# Тот же Postgres-инстанс, что у Node-приложения, но своя схема:
# identity_keys, signed_prekeys, one_time_prekeys. Миграции применяются
# автоматически при старте.
DATABASE_URL=postgresql://user:pass@localhost:5432/nyxo

# Общий секрет для внутренней аутентификации запросов от Node.
# Минимум 32 символа, иначе сервис откажется стартовать.
# Значение должно быть равно INTERNAL_KEY_SERVER_SECRET в корневом .env.
INTERNAL_SHARED_SECRET=your_secure_random_secret_here_min_32_chars

# Только loopback: сервис не должен быть доступен из интернета напрямую,
# вся авторизация пользователей происходит в Node до проксирования.
BIND_ADDR=127.0.0.1:7420

# Максимум one-time prekeys в одном запросе на пополнение пула.
MAX_OTPK_BATCH=200
