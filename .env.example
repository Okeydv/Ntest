SESSION_SECRET=your_random_secret_min_32_chars
DATABASE_URL=postgresql://user:pass@localhost:5432/nyxo
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# E2EE Key Server
INTERNAL_KEY_SERVER_SECRET=your_secure_random_secret_here_min_32_chars
KEY_SERVER_URL=http://127.0.0.1:7420

# Адреса, с которых разрешено подключение сокета (через запятую, с
# протоколом). Origin того же хоста, что и запрос, разрешён всегда; список
# нужен, если прокси переписывает Host. Добавьте сюда и .onion-адрес.
# ALLOWED_ORIGINS=https://nyxo.example,http://abcdefghijklmnop.onion

# Настройки для Tor (опционально)
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
ENABLE_TOR_ROUTING=false

# Настройки disappearing messages
DEFAULT_MESSAGE_EXPIRY_SECONDS=0
CLEANUP_INTERVAL_MS=60000

# Cloudflare IP ranges (опционально, для кастомизации)
# CF_IP_RANGES=173.245.48.0/20,103.21.244.0/22

# SSL для production
# DB_CA_CERT=your_certificate_chain_here

# Куда сообщать об уязвимостях — отдаётся в /.well-known/security.txt.
# Не задано — файла нет.
# SECURITY_CONTACT=mailto:security@nyxo.example

# База в production: DB_CA_CERT — сертификат (цепочку покажет запуск с
# DUMP_CA=true), либо DB_SSL=disable, если база на этом же хосте или во
# внутренней сети. Без одного из них сервер в production не запустится.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----...
# DB_SSL=disable

# Журнал сервера: JSON, строка на запись (читать глазами — npx pino-pretty).
# debug добавляет строку на каждый запрос (маршрут шаблоном, без id).
# LOG_LEVEL=info
